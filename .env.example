# Dharma Studio keys — read from this file only; never stored in the DB, never shown in the UI.
# Leave a key empty and that provider runs in dry-run mode (Pillow placeholders / rule-based fallbacks).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TOPAZ_API_KEY=

# Models (defaults shown)
TOPAZ_MODEL=Wonder 3.5
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_PRO_IMAGE_MODEL=gemini-3-pro-image
SUNBURST_MODEL=gpt-image-2.5-sunburst
AGENT_MODEL=claude-sonnet-4-5

# Where studio.db, candidates, refs, canvases, exports live (default ./data)
DATA_DIR=./data
PORT=8787
